# Copy to renderer/.env for LOCAL use, or set these as variables in your host (Railway/Fly). NEVER commit real values.
# ---- required in production (RF_ENV=production) ----
RF_MASTER_KEY=            # openssl rand -base64 32  — encrypts API keys saved in Settings. LOSE IT = saved keys unreadable.
RF_ADMIN_PASSWORD=        # 12+ characters. Login for the web Studio.
RF_PUBLIC_HOST=           # your public hostname, e.g. studio.example.com (no scheme)
# ---- storage (the Dockerfile already sets these to /data) ----
RF_STUDIO_DIR=/data/studio
# ---- optional: provider keys can be set here OR (recommended) in Settings → AI 연동 (stored encrypted) ----
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MUAPI_API_KEY=
HEYGEN_API_KEY=
# ---- safety defaults (modes can also be switched in Settings with typed confirmation) ----
RF_MUAPI_MODE=mock        # leave as mock; live is turned on in Settings after the key is saved
RF_STUDIO_VOICE_MODE=mock
RF_REEL_SPEND_LIMIT_USD=5
# ---- optional Google Sheets mirror (existing V2.2 bridge) ----
RF_SHEETS_BRIDGE_URL=
RF_SHEETS_BRIDGE_TOKEN=
