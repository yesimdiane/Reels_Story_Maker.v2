# Copy to renderer/.env (git-ignored). Never commit real values.

# From Google Sheets menu "릴스 팩토리 → 렌더 키 보기". Required: only signed, approved jobs render.
RF_RENDER_SECRET=

# Voice Provider: heygen (default) or google (backup)
# RF_TTS_PROVIDER=heygen

# Google Cloud Text-to-Speech API key, restricted to "Cloud Text-to-Speech API".
GOOGLE_TTS_API_KEY=

# HeyGen Text-to-Speech API (for cloned voice synthesis without avatar)
# HEYGEN_API_KEY=
# RF_HEYGEN_VOICE_ID=5bfc3fa102124f7681ee3ffb34bcf1bf

# Gemini checks the finished video against the approved script and your verified product images
# (advisory only; skipped for --preview or with --no-ai-check). Key lives here only, never in Git.
# GEMINI_API_KEY=
# RF_GEMINI_MODEL=gemini-3.5-flash
# Verified product images for that check: renderer/refs/<상품ID>/*.png|jpg|webp, or (default) the Drive IDs in the job.
# RF_REFS_DIR=
# Drive access for `fetch-clips` and Drive product images: `gcloud auth login --enable-gdrive-access`, or a token:
# RF_DRIVE_ACCESS_TOKEN=

# Voice: cheapest Korean families are Standard/Wavenet. Neural2/Chirp3-HD sound better and cost more.
RF_TTS_VOICE=ko-KR-Wavenet-A
RF_TTS_RATE=1.05

# Cost guards (characters). Google bills every character incl. spaces.
RF_TTS_MAX_CHARS_PER_JOB=1500
RF_TTS_MONTHLY_CHAR_LIMIT=500000

# FFmpeg: if `node renderer/cli.js check` says the ass filter is missing, install ffmpeg-full and set:
# RF_FFMPEG=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# RF_FFPROBE=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe

# Font (macOS default: Apple SD Gothic Neo). Optional folder with extra .ttf/.otf files:
# RF_FONT_NAME=Apple SD Gothic Neo
# RF_FONTS_DIR=

# Google Drive for desktop: point the renderer at your synced ReelsFactory folder (see docs/mac-install.md).
# RF_JOBS_DIR=/Users/<you>/Library/CloudStorage/GoogleDrive-<you>@gmail.com/My Drive/ReelsFactory/jobs
# RF_CLIPS_DIR=/Users/<you>/Library/CloudStorage/GoogleDrive-<you>@gmail.com/My Drive/ReelsFactory/clips
# RF_OUTPUT_DIR=/Users/<you>/Library/CloudStorage/GoogleDrive-<you>@gmail.com/My Drive/ReelsFactory/output

# Provenance recorded for clips that have no assets.json (your workflow: Google Flow).
RF_DEFAULT_FOOTAGE_SOURCE=flow-generated

# ---------------------------------------------------------------------------------------------
# Reels Factory Studio V2 (node studio/server.js) — see docs/studio-v2.md
# Keys are read ONLY by the server process. They are never sent to the browser, logged or committed.
# ---------------------------------------------------------------------------------------------
# Muapi (image-to-video). Leave unset for MOCK mode.
# MUAPI_API_KEY=
# MOCK is the default. Paid calls are possible ONLY if this is exactly "live" AND MUAPI_API_KEY is set.
# Even then every generation must be authorized on screen after seeing the estimated cost.
# RF_MUAPI_MODE=mock
# RF_MUAPI_BASE_URL=https://api.muapi.ai/api/v1
# Spending limit per reel in USD (can be overridden per reel in the UI).
# RF_REEL_SPEND_LIMIT_USD=5

# HeyGen multi-character voices. MOCK (tone audio) unless exactly "live" and HEYGEN_API_KEY is set.
# (HEYGEN_API_KEY is the same key as above.)
# RF_STUDIO_VOICE_MODE=mock

# Studio server
# RF_STUDIO_DIR=~/.reels-factory/studio
# RF_STUDIO_HOST=127.0.0.1
# RF_STUDIO_PORT=4173
# Optional access token (required if you ever expose the Studio beyond localhost):
# RF_STUDIO_TOKEN=
